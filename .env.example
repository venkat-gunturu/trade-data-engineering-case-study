# Copy to .env and fill in real values. Never commit .env.
# Read by data_generator/ingest_trades.py, and injected into the Airflow
# containers by docker-compose.yml.
#
# IN GITHUB ACTIONS, six of these become repository secrets:
#   SNOWFLAKE_ACCOUNT  SNOWFLAKE_USER  SNOWFLAKE_PASSWORD
#   SNOWFLAKE_ROLE     SNOWFLAKE_WAREHOUSE  SNOWFLAKE_DATABASE
# Everything else below is local-only: DBT_TARGET_SCHEMA and DBT_THREADS are
# set as plain configuration in the workflow files, the ORGANIZATION/ACCOUNT
# pair is for local Terraform, and ALERT_EMAIL_RECIPIENT and the AIRFLOW_*
# values are only used by the local runtime. See README section 17.

# --- Connection (used by both the Python loader and the dbt profile) ---
SNOWFLAKE_ACCOUNT=your_account_identifier

# Terraform only. The Snowflake Terraform provider v2 replaced the single
# SNOWFLAKE_ACCOUNT identifier with an organization/account pair. Split your
# account identifier on the hyphen: ORGNAME-ACCOUNTNAME.
# SNOWFLAKE_ACCOUNT above stays as-is; Python and dbt still use it.
SNOWFLAKE_ORGANIZATION_NAME=your_org_name
SNOWFLAKE_ACCOUNT_NAME=your_account_name
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=TRADE_WH
SNOWFLAKE_DATABASE=TRADE_DB

# Ingestion target schema for PUT / COPY INTO.
SNOWFLAKE_SCHEMA=RAW

# --- Monitoring / alerting (Phase 7) ---
# Where failure notifications are emailed. Snowflake sends the mail through the
# TRADE_ALERT_EMAIL notification integration, so no SMTP server is needed.
#
# MANUAL PREREQUISITE: this must be a VERIFIED email address of a user in your
# Snowflake account (Snowsight -> profile -> verify email). SYSTEM$SEND_EMAIL
# refuses to deliver to an unverified address.
#
# If this is left unset the pipeline still runs and still fails visibly; the
# notify_failure task simply reports that no email could be sent.
ALERT_EMAIL_RECIPIENT=your_verified_snowflake_email

# --- dbt (Phase 3) ---
# dbt's default schema for models. Kept separate from SNOWFLAKE_SCHEMA above:
# that one is where raw data lands, this one is dbt's build target.
DBT_TARGET_SCHEMA=BRONZE
DBT_THREADS=4

# --- Airflow / Docker (Phase 4) ---
# docker-compose.yml injects this whole file into the Airflow containers, so the
# Snowflake settings above are what the DAG uses at runtime.
#
# Local-only values. None of these are Snowflake credentials.
#
# On Linux hosts, set AIRFLOW_UID to your own uid (run: id -u) so files the
# containers write into data/ and dbt/ stay owned by you. Leave it commented out
# on Windows and macOS Docker Desktop, where the 50000 default is correct.
# AIRFLOW_UID=1000

# Web UI login created by the airflow-init container.
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=airflow

# Session-cookie signing key for the local web UI.
AIRFLOW_SECRET_KEY=local-dev-secret-key
